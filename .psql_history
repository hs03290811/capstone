CREATE EXTENSION pgrouting;
\q
ALTER TABLE segments_table ADD COLUMN source INTEGER;
ALTER TABLE segments_table ADD COLUMN target INTEGER;
SELECT pgr_createTopology('segments_table', 0.00001, 'geometry', 'segment_id', 'source', 'target');
\q
-- ("두 번째" psql 프롬프트 "postgres=>" 에서 실행)SELECT pid, query, state, wait_event, wait_event_type FROM pg_stat_activity WHERE state = 'active';
TRUNCATE TABLE segments_table;
ALTER TABLE segments_table ADD COLUMN source INTEGER;
ALTER TABLE segments_table ADD COLUMN target INTEGER;
CREATE INDEX segments_geom_idx_gist ON segments_table USING GIST (geometry);
SELECT pgr_createTopology('segments_table', 0.00001, 'geometry', 'segment_id', 'source', 'target');
CREATE INDEX ON segments_table (source);
CREATE INDEX ON segments_table (target);
\q
WITH components AS (    -- 1.5M 건을 분석하여 각 노드가 속한 '섬(component)' ID를 찾습니다.    SELECT * FROM pgr_connected_components(        'SELECT segment_id AS id, source, target, length AS cost FROM segments_table'    ))-- 3. 우리가 테스트한 두 노드(1093050, 732075)가 몇 번 섬에 속하는지 확인SELECT vertex_id, componentFROM componentsWHERE vertex_id IN (1093050, 732075);
WITH components AS (    SELECT * FROM pgr_connectedComponents(  -- (★) 'C'를 대문자로 수정        'SELECT segment_id AS id, source, target, length AS cost FROM segments_table'    ))SELECT vertex_id, componentFROM componentsWHERE vertex_id IN (1093050, 732075);
WITH components AS (    SELECT * FROM pgr_connectedComponents(        'SELECT segment_id AS id, source, target, length AS cost FROM segments_table'    ))SELECT     node,       -- (★) 'vertex_id'가 아니라 'node'입니다    componentFROM componentsWHERE node IN (1093050, 732075); -- (★) 'vertex_id'가 아니라 'node'입니다
SELECT component, count(*) AS node_countFROM pgr_connectedComponents(    'SELECT segment_id AS id, source, target, length AS cost FROM segments_table')GROUP BY componentORDER BY node_count DESCLIMIT 10;
-- (주의) 기존 데이터를 모두 지우고 테이블 구조 자체를 없앱니다.DROP TABLE segments_table;
cd /Users/peachee/Desktop/CAU/capstone/source/demscp -i ~/Downloads/capstone-key.pem merged_dem.tif ubuntu@54.209.205.37:/home/ubuntu/ls -lh merged_dem.tif
\q
-- 1. source, target 컬럼 추가ALTER TABLE segments_table ADD COLUMN source INTEGER;ALTER TABLE segments_table ADD COLUMN target INTEGER;-- 2. GIST 공간 인덱스 생성 (★중요★ 속도 필수)CREATE INDEX segments_geom_idx_gist ON segments_table USING GIST (geometry);-- 3. 토폴로지 생성 (★허용 오차 0.00005 적용★)-- (강남역 사거리 등 끊어진 도로를 5.5m 안에서 이어붙입니다)SELECT pgr_createTopology('segments_table', 0.00005, 'geometry', 'segment_id', 'source', 'target');-- 4. 검색용 인덱스 생성CREATE INDEX ON segments_table (source);CREATE INDEX ON segments_table (target);-- 5. (★API용★) 분기점 카운트(cnt) 계산 및 업데이트-- (이게 있어야 "주요 분기점입니다" 안내가 나옵니다)WITH edge_counts AS (    SELECT source AS node_id, COUNT(*) AS edge_count FROM segments_table GROUP BY source    UNION ALL    SELECT target AS node_id, COUNT(*) AS edge_count FROM segments_table GROUP BY target),total_counts AS (    SELECT node_id, SUM(edge_count) AS total_edges    FROM edge_counts    GROUP BY node_id)UPDATE segments_table_vertices_pgr vSET cnt = t.total_edgesFROM total_counts tWHERE v.id = t.node_id;
\ㅂ
\q
-- 고도 데이터가 NULL인 도로의 개수 조회SELECT count(*) FROM segments_table WHERE start_elev IS NULL OR end_elev IS NULL;
\q
-- source가 비어있는 행의 개수를 셉니다.SELECT count(*) FROM segments_table WHERE source IS NULL;
WITH edge_counts AS (    SELECT source AS node_id, COUNT(*) AS edge_count FROM segments_table GROUP BY source    UNION ALL    SELECT target AS node_id, COUNT(*) AS edge_count FROM segments_table GROUP BY target),total_counts AS (    SELECT node_id, SUM(edge_count) AS total_edges    FROM edge_counts    GROUP BY node_id)UPDATE segments_table_vertices_pgr vSET cnt = t.total_edgesFROM total_counts tWHERE v.id = t.node_id;
SELECT cnt, count(*) FROM segments_table_vertices_pgr GROUP BY cnt ORDER BY cnt;
SELECT id, cnt FROM segments_table_vertices_pgr ORDER BY     the_geom <-> ST_SetSRID(ST_MakePoint(127.0276, 37.4979), 4326) LIMIT 1;
SELECT id, cnt, ST_Y(the_geom) as lat, ST_X(the_geom) as lonFROM segments_table_vertices_pgr WHERE cnt >= 4 ORDER BY the_geom <-> ST_SetSRID(ST_MakePoint(127.0276, 37.4979), 4326) LIMIT 1;
SELECT count(*) FROM segments_table WHERE start_elev = 0 OR end_elev = 0;
SELECT count(*) FROM segments_table WHERE length > 10 -- 아주 짧은 구간 제외AND abs((end_elev - start_elev) / length * 100) > 50; -- 50% 이상 경사
\q
-- source(출발점 ID)가 비어있는지 확인SELECT count(*) FROM segments_table WHERE source IS NULL;
\q
-- 3. 검색 속도 향상을 위한 인덱스 생성 (필수)-- (기존 인덱스가 있을 수 있으니 삭제 후 재생성)DROP INDEX IF EXISTS segments_table_source_idx;DROP INDEX IF EXISTS segments_table_target_idx;CREATE INDEX segments_table_source_idx ON segments_table (source);CREATE INDEX segments_table_target_idx ON segments_table (target);-- 4. (★중요★) 분기점(cnt) 정보 업데이트-- (이게 되어야 "주요 분기점입니다" 안내가 나옵니다)WITH edge_counts AS (    SELECT source AS node_id, COUNT(*) AS edge_count FROM segments_table GROUP BY source    UNION ALL    SELECT target AS node_id, COUNT(*) AS edge_count FROM segments_table GROUP BY target),total_counts AS (    SELECT node_id, SUM(edge_count) AS total_edges    FROM edge_counts    GROUP BY node_id)UPDATE segments_table_vertices_pgr vSET cnt = t.total_edgesFROM total_counts tWHERE v.id = t.node_id;
\q
